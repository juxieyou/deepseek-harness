{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DSH: Debug Web",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx/esm"],
      "program": "${workspaceFolder}/apps/cli/src/bin.ts",
      "args": ["web"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}